{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrAuth",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "EcrPush",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:PutImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload"
      ],
      "Resource": [
        "arn:aws:ecr:us-east-1:<NEW_ACCOUNT_ID>:repository/devops-g1-ride-api",
        "arn:aws:ecr:us-east-1:<NEW_ACCOUNT_ID>:repository/devops-g1-matching-service",
        "arn:aws:ecr:us-east-1:<NEW_ACCOUNT_ID>:repository/devops-g1-dispatch-service"
      ]
    },
    {
      "Sid": "EcsDeploy",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeServices",
        "ecs:DescribeTaskDefinition",
        "ecs:RegisterTaskDefinition",
        "ecs:UpdateService"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassEcsRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::<NEW_ACCOUNT_ID>:role/devops-g1-iac-ecs-execution-role",
        "arn:aws:iam::<NEW_ACCOUNT_ID>:role/devops-g1-iac-ride-api-task-role",
        "arn:aws:iam::<NEW_ACCOUNT_ID>:role/devops-g1-iac-matching-service-task-role",
        "arn:aws:iam::<NEW_ACCOUNT_ID>:role/devops-g1-iac-dispatch-service-task-role"
      ]
    }
  ]
}
